# Configuración de la Vitrina de Proyectos.
# Normalmente no lo necesitas: instalar.php crea el archivo .env solo.
# Si prefieres hacerlo a mano, copia este archivo como .env, cambia los datos
# y luego crea las tablas abriendo instalar.php.
# No compartas el .env: tiene la contraseña de la base de datos.

# Base de datos MySQL (cPanel les pone el prefijo de tu cuenta)
DB_HOST="localhost"
DB_PORT=""
DB_DATABASE="micuenta_vitrina"
DB_USERNAME="micuenta_vitrina"
DB_PASSWORD="la-contraseña-de-mysql"
# Opcional: si se define, reemplaza a los cinco valores de arriba.
# DB_DSN="mysql:host=localhost;dbname=micuenta_vitrina;charset=utf8mb4"

# Panel
APP_TIMEZONE="America/Bogota"
# Tamaño máximo de cada archivo dentro del .zip, en MB
UPLOAD_MAX_MB="50"

# Seguridad de la sesión y del inicio de sesión
SESSION_COOKIE="vitrina_sesion"
SESSION_DAYS="30"
# Por usuario: tras LOGIN_MAX_ATTEMPTS fallos se bloquea LOGIN_LOCK_SECONDS;
# cada fallo extra duplica la espera hasta LOGIN_LOCK_MAX_SECONDS.
LOGIN_MAX_ATTEMPTS="5"
LOGIN_LOCK_SECONDS="60"
LOGIN_LOCK_MAX_SECONDS="900"
# Por conexión (IP): fallos permitidos en la ventana, sin importar el usuario.
LOGIN_IP_MAX_ATTEMPTS="20"
LOGIN_IP_WINDOW_SECONDS="900"
