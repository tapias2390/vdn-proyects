# Configuración de la Vitrina de Proyectos · XAMPP local (desarrollo).
# No compartas este archivo: tiene la contraseña de la base de datos.
# Para el hosting usa .env.produccion (cámbiale los datos de MySQL y súbelo como .env).

# Base de datos MySQL (XAMPP: usuario root sin contraseña)
DB_HOST="localhost"
DB_PORT=""
DB_DATABASE="vitrina"
DB_USERNAME="root"
DB_PASSWORD=""

# Panel
APP_TIMEZONE="America/Bogota"
# Tamaño máximo de cada archivo dentro del .zip, en MB
UPLOAD_MAX_MB="50"

# Seguridad de la sesión y del inicio de sesión
SESSION_COOKIE="vitrina_sesion"
SESSION_DAYS="30"
# Por usuario: tras LOGIN_MAX_ATTEMPTS fallos se bloquea LOGIN_LOCK_SECONDS;
# cada fallo extra duplica la espera hasta LOGIN_LOCK_MAX_SECONDS.
LOGIN_MAX_ATTEMPTS="5"
LOGIN_LOCK_SECONDS="60"
LOGIN_LOCK_MAX_SECONDS="900"
# Por conexión (IP): fallos permitidos en la ventana, sin importar el usuario.
LOGIN_IP_MAX_ATTEMPTS="20"
LOGIN_IP_WINDOW_SECONDS="900"
